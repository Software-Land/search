{
  // Declaration emit for the designed public facades only.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "WebWorker"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/index.ts",
    "src/api.ts",
    "src/browser/index.ts",
    "src/browser/api.ts",
    "src/documentId.ts",
    "src/saturatingFrequency.ts",
    "src/text.ts",
    "src/lexicalNormalize.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["examples/**", "src/ambient-core.d.ts", "src/browser/types.d.ts"]
}
