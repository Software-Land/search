{
  "name": "@software-land/search",
  "version": "0.6.9",
  "private": false,
  "description": "Deterministic, explainable document search with optional offline corpus and semantic compilation.",
  "license": "BUSL-1.1",
  "author": "Sam Malayek",
  "keywords": [
    "search",
    "lexical",
    "ranking",
    "explainable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Software-Land/search.git"
  },
  "homepage": "https://github.com/Software-Land/search#readme",
  "bugs": {
    "url": "https://github.com/Software-Land/search/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./corpus": {
      "types": "./tools/search-corpus/index.d.ts",
      "import": "./tools/search-corpus/index.js"
    },
    "./relationships": {
      "types": "./tools/search-relationships/index.d.ts",
      "import": "./tools/search-relationships/index.js"
    },
    "./semantic": {
      "types": "./tools/search-semantic/index.d.ts",
      "import": "./tools/search-semantic/index.js"
    },
    "./lexical": {
      "types": "./tools/search-lexical/index.d.ts",
      "import": "./tools/search-lexical/index.js"
    }
  },
  "files": [
    "LICENSE",
    "COMMERCIAL-LICENSING.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "dist",
    "tools/search-corpus",
    "tools/search-relationships",
    "tools/search-semantic",
    "tools/search-lexical",
    "!tools/**/*.ts",
    "tools/**/*.d.ts",
    "!**/*.js.map",
    "!**/*.d.ts.map",
    "!docs/historical-v1-mismatch-inventory.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.emit.json && tsc -p tsconfig.dts.json && node scripts/keep-public-dts.mjs && tsc -p tsconfig.tools-emit.json && tsc -p tsconfig.tools-emit-relationships.json && tsc -p tsconfig.tools-emit-corpus.json && tsc -p tsconfig.tools-emit-semantic.json && node scripts/keep-public-tool-dts.mjs",
    "build:oracles": "node scripts/emit-test-oracles.mjs",
    "prepack": "npm run build",
    "typecheck": "npm run build && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test:types": "npm run build && tsc -p test/types/tsconfig.json",
    "test": "npm run build && npm run build:oracles && node --experimental-vm-modules ./node_modules/jest/bin/jest.js && python3 -m unittest discover -s tools/search-semantic/tests -p 'test_*.py'",
    "test:js": "npm run build && npm run build:oracles && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:python": "python3 -m unittest discover -s tools/search-semantic/tests -p 'test_*.py'",
    "example": "npm run build && node examples/catalog/index.mjs",
    "smoke:import": "npm run build && node scripts/import-smoke.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "test:chromium-pack": "node test/chromium-pack/runner.mjs",
    "test:chromium-real-corpus": "node test/chromium-pack/software-land-scenarios.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "jest": "^29.7.0",
    "typescript": "6.0.3"
  }
}
